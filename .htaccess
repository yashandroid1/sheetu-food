<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to hidden files and folders (.env, .git, etc.)
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Block access to sensitive files
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|\.env.*|artisan|default\.php)$ - [F,L]

    # Block access to sensitive directories
    RewriteRule ^(database|storage/logs)/ - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect all other requests to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
